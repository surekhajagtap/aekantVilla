        {
          "@type": "Question",
          "name": "How far is Aekant Villa from Mumbai, Thane, Pune and Nashik?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Aekant Villa is roughly 3.5 hours from Mumbai, 3 hours from Thane, 4.5 hours from Pune and just 45 minutes from Nashik city, by road via Trimbakeshwar."
          }
        },
        {
          "@type": "Question",
          "name": "Does Aekant Villa have a private swimming pool?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Aekant Villa has a private swimming pool reserved exclusively for in-house guests, with mountain and Vaitarna backwater views."
          }
        },
        {
          "@type": "Question",
          "name": "What does it cost to book Aekant Villa per night?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Weekday nights are ₹9,000, weekend nights are ₹12,000 for the entire villa, and the couple package is ₹3,000 per night. Complimentary breakfast is included in every package."
          }
        },
        {
          "@type": "Question",
          "name": "How many guests can stay at Aekant Villa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The villa has 3 spacious bedrooms and 4 bathrooms, plus a large hall and terrace, comfortably hosting families, groups of friends and corporate teams."
          }
        },
        {
          "@type": "Question",
          "name": "How do I book Aekant Villa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Book directly on WhatsApp at +91 86683 31054 for the best available rate, or message @aekant_villa on Instagram or email booking@aekantvilla.com."
          }
        },
        {
          "@type": "Question",
          "name": "What is there to do near Aekant Villa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The villa is close to the Trimbakeshwar Shiva Jyotirlinga Temple, the Vaitarna Dam backwaters, Pahine Waterfall, sunrise and sunset points, and scenic nature-walk trails."
          }
        }
